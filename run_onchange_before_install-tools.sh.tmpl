#!/bin/sh
# Installe les outils dont dépendent les dotfiles s'ils manquent.
# Rejoué quand ce fichier change, donc quand une version ci-dessous bouge.
#
# AGE_VERSION: 1.2.1
# GH_VERSION: 2.63.2
# JQ_VERSION: 1.8.2
# RG_VERSION: 15.2.0
# NVIM_VERSION: 0.12.5
# FD_VERSION: 10.5.0
# DUF_VERSION: 0.9.1
# UV_VERSION: 0.12.8
#
# age      : déchiffre ~/.secrets. Indispensable - l'implémentation intégrée à
#            chezmoi ne gère pas les passphrases et échoue sur
#            « no identities specified ».
# gh       : helper d'identifiants git pour ce repo privé (cf. .gitconfig).
# jq       : filtrage JSON, attendu par les scripts et les agents.
# ripgrep  : recherche de code, attendue par les agents et par Neovim (telescope).
# starship : prompt. Facultatif, .zshrc retombe sur le prompt zsh par défaut.
# neovim   : ~/.config/nvim est déployé partout (LazyVim), qui exige nvim >= 0.11.
# fd       : recherche de fichiers, attendue par telescope à côté de ripgrep.
# duf      : .zshrc en fait l'alias de df quand il est présent.
# uv       : lance scrapling-mcp, déployé dans ~/.local/bin.
#
# Le bloc darwin ajoute ce qui n'a de sens que sur macOS : thefuck (alias posé
# par .zshrc), pinentry-mac (saisie du PIN de la YubiKey, ADR-010), ykman,
# bitwarden-cli. Et, si la machine est un poste graphique, les apps
# (ADR-019).

set -eu

AGE_VERSION=1.2.1
GH_VERSION=2.63.2
JQ_VERSION=1.8.2
RG_VERSION=15.2.0
NVIM_VERSION=0.12.5
FD_VERSION=10.5.0
DUF_VERSION=0.9.1
UV_VERSION=0.12.8
BIN="$HOME/bin"

{{ if eq .chezmoi.os "darwin" -}}
if command -v brew >/dev/null; then
  # « formule:commande », car ripgrep s'installe sous ce nom et s'appelle rg.
  #
  # Une formule qui échoue n'interrompt pas les suivantes, ni le bloc des
  # applications : sans ce garde, set -e abandonnerait l'apply au milieu.
  # Le cas s'est produit sur un mac arm64 dont le brew de tête est celui de
  # /usr/local, sous Rosetta : bitwarden-cli n'y a pas de bouteille et sa
  # compilation échoue sur « unsupported argument 'westmere' to -march= ».
  for f in age:age gh:gh jq:jq ripgrep:rg starship:starship neovim:nvim fd:fd \
           duf:duf uv:uv thefuck:thefuck pinentry-mac:pinentry-mac ykman:ykman \
           bitwarden-cli:bw; do
    if ! command -v "${f#*:}" >/dev/null; then
      brew install "${f%:*}" || echo "⚠️   ${f%:*} non installé" >&2
    fi
  done

{{/* « get » et non « .gui » : une machine installée avant ADR-019 a un
     chezmoi.toml sans cette clé, sur laquelle .gui ferait échouer l'apply. */}}
{{ if get . "gui" }}
  # --appdir explicite : ce script tourne sous sh depuis chezmoi et ne lit pas
  # .zshrc, où HOMEBREW_CASK_OPTS porte la même valeur pour les shells.
  # Les cinq casks interpolent #{appdir} partout, y compris OrbStack et ses
  # binaires orb/orbctl : aucun n'impose /Applications.
  APPDIR="$HOME/Applications"
  mkdir -p "$APPDIR"

  # « cask:App », le second servant à détecter une installation posée hors de
  # Homebrew - cas d'un OrbStack venu de son propre installeur.
  for c in arc:Arc bitwarden:Bitwarden claude:Claude orbstack:OrbStack warp:Warp; do
    app="${c#*:}.app"
    if [ -d "$APPDIR/$app" ] || [ -d "/Applications/$app" ]; then
      continue
    fi
    brew install --cask --appdir="$APPDIR" "${c%:*}" || \
      echo "⚠️   $app non installé" >&2
  done
{{ end }}
  exit 0
fi
{{ end -}}

# zsh ne s'installe pas en binaire statique : il lui faut son arborescence de
# fonctions (/usr/share/zsh) à côté. Il passe donc par le gestionnaire de
# paquets quand il y en a un - cas des conteneurs, pas du NAS.
if ! command -v zsh >/dev/null; then
  if [ "$(id -u)" = 0 ]; then sudo=""; elif command -v sudo >/dev/null; then sudo="sudo"; else sudo="none"; fi

  if [ "$sudo" = none ]; then
    echo "⚠️   zsh absent et pas de droits root pour l'installer" >&2
  elif command -v apt-get >/dev/null; then
    # env, et pas un préfixe VAR=... : sudo purge l'environnement par défaut.
    $sudo apt-get update -qq && $sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq zsh
  elif command -v apk >/dev/null; then
    $sudo apk add --quiet zsh
  elif command -v dnf >/dev/null; then
    $sudo dnf install -y -q zsh
  elif command -v pacman >/dev/null; then
    $sudo pacman -Sy --noconfirm --quiet zsh
  else
    # DSM notamment : ni apt ni apk. zsh vient d'Entware (opkg install zsh).
    echo "⚠️   zsh absent et aucun gestionnaire de paquets connu" >&2
  fi

  # if, pas &&, sinon set -e ferait échouer le script quand zsh manque encore.
  if command -v zsh >/dev/null; then
    echo "🐚  zsh installé"
  fi
fi

# Machines sans gestionnaire de paquets (NAS Synology, conteneurs) : binaires
# statiques dans ~/bin, mis dans le PATH par .zshenv.
case "$(uname -m)" in
  # Trois nomenclatures, une par amont : « amd64 » (age, gh, jq), le triplet
  # Rust (ripgrep, fd, uv), « x86_64 » (duf, neovim).
  x86_64)          arch=amd64; musl=x86_64-unknown-linux-musl;  uarch=x86_64 ;;
  aarch64|arm64)   arch=arm64; musl=aarch64-unknown-linux-musl; uarch=arm64 ;;
  *) echo "⚠️   architecture $(uname -m) non gérée, installation manuelle requise" >&2
     exit 0 ;;
esac

mkdir -p "$BIN" "$HOME/.cache"
# Pas /tmp : monté noexec sur DSM, et tar y écrirait des binaires inutilisables.
tmp=$(mktemp -d "$HOME/.cache/install-tools.XXXXXX")
trap 'rm -rf "$tmp"' EXIT

fetch() { curl -fsSL --retry 3 -o "$2" "$1"; }

if ! command -v age >/dev/null; then
  if fetch "https://github.com/FiloSottile/age/releases/download/v${AGE_VERSION}/age-v${AGE_VERSION}-linux-${arch}.tar.gz" "$tmp/age.tgz" &&
     tar xzf "$tmp/age.tgz" -C "$tmp"; then
    mv "$tmp/age/age" "$tmp/age/age-keygen" "$BIN/" && chmod +x "$BIN/age" "$BIN/age-keygen"
    echo "🔑  age $AGE_VERSION installé dans ~/bin"
  else
    echo "⚠️   age non installé : ~/.secrets restera chiffré" >&2
  fi
fi

if ! command -v gh >/dev/null; then
  if fetch "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_${arch}.tar.gz" "$tmp/gh.tgz" &&
     tar xzf "$tmp/gh.tgz" -C "$tmp"; then
    mv "$tmp/gh_${GH_VERSION}_linux_${arch}/bin/gh" "$BIN/" && chmod +x "$BIN/gh"
    echo "🐙  gh $GH_VERSION installé dans ~/bin - pense à « gh auth login »"
  else
    echo "⚠️   gh non installé : les pulls demanderont un mot de passe" >&2
  fi
fi

if ! command -v jq >/dev/null; then
  if fetch "https://github.com/jqlang/jq/releases/download/jq-${JQ_VERSION}/jq-linux-${arch}" "$tmp/jq"; then
    mv "$tmp/jq" "$BIN/" && chmod +x "$BIN/jq"
    echo "🧮  jq $JQ_VERSION installé dans ~/bin"
  else
    echo "⚠️   jq non installé" >&2
  fi
fi

if ! command -v rg >/dev/null; then
  if fetch "https://github.com/BurntSushi/ripgrep/releases/download/${RG_VERSION}/ripgrep-${RG_VERSION}-${musl}.tar.gz" "$tmp/rg.tgz" &&
     tar xzf "$tmp/rg.tgz" -C "$tmp"; then
    mv "$tmp/ripgrep-${RG_VERSION}-${musl}/rg" "$BIN/" && chmod +x "$BIN/rg"
    echo "🔎  ripgrep $RG_VERSION installé dans ~/bin"
  else
    echo "⚠️   ripgrep non installé" >&2
  fi
fi

if ! command -v starship >/dev/null; then
  # L'installeur amont déverse les instructions de configuration de dix shells.
  if curl -fsSL https://starship.rs/install.sh | sh -s -- -b "$BIN" -y >/dev/null; then
    echo "🚀  starship installé dans ~/bin"
  else
    echo "⚠️   starship non installé, prompt zsh par défaut" >&2
  fi
fi

if ! command -v fd >/dev/null; then
  if fetch "https://github.com/sharkdp/fd/releases/download/v${FD_VERSION}/fd-v${FD_VERSION}-${musl}.tar.gz" "$tmp/fd.tgz" &&
     tar xzf "$tmp/fd.tgz" -C "$tmp"; then
    mv "$tmp/fd-v${FD_VERSION}-${musl}/fd" "$BIN/" && chmod +x "$BIN/fd"
    echo "📁  fd $FD_VERSION installé dans ~/bin"
  else
    echo "⚠️   fd non installé : telescope retombe sur find" >&2
  fi
fi

if ! command -v duf >/dev/null; then
  if fetch "https://github.com/muesli/duf/releases/download/v${DUF_VERSION}/duf_${DUF_VERSION}_linux_${uarch}.tar.gz" "$tmp/duf.tgz" &&
     tar xzf "$tmp/duf.tgz" -C "$tmp"; then
    mv "$tmp/duf" "$BIN/" && chmod +x "$BIN/duf"
    echo "💾  duf $DUF_VERSION installé dans ~/bin"
  else
    echo "⚠️   duf non installé : df reste df" >&2
  fi
fi

if ! command -v uv >/dev/null; then
  if fetch "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-${musl}.tar.gz" "$tmp/uv.tgz" &&
     tar xzf "$tmp/uv.tgz" -C "$tmp"; then
    mv "$tmp/uv-${musl}/uv" "$tmp/uv-${musl}/uvx" "$BIN/" && chmod +x "$BIN/uv" "$BIN/uvx"
    echo "🐍  uv $UV_VERSION installé dans ~/bin"
  else
    echo "⚠️   uv non installé : scrapling-mcp ne démarrera pas" >&2
  fi
fi

# nvim n'est pas un binaire seul : il lui faut son VIMRUNTIME (share/nvim) à
# côté, comme zsh ses fonctions. L'archive amont porte les deux, d'où
# l'arborescence dans ~/.local/nvim et un lien dans ~/bin. Elle est liée à la
# glibc : sur une Alpine, l'extraction réussit et le binaire ne tourne pas.
if ! command -v nvim >/dev/null; then
  if fetch "https://github.com/neovim/neovim/releases/download/v${NVIM_VERSION}/nvim-linux-${uarch}.tar.gz" "$tmp/nvim.tgz" &&
     tar xzf "$tmp/nvim.tgz" -C "$tmp"; then
    rm -rf "$HOME/.local/nvim"
    mkdir -p "$HOME/.local"
    mv "$tmp/nvim-linux-${uarch}" "$HOME/.local/nvim"
    ln -sf "$HOME/.local/nvim/bin/nvim" "$BIN/nvim"
    echo "📝  neovim $NVIM_VERSION installé dans ~/.local/nvim"
  else
    echo "⚠️   neovim non installé : ~/.config/nvim reste inerte" >&2
  fi
fi
