{{- $choices := list "perso" "pro" -}}
{{- $profile := promptChoiceOnce . "profile" "Profil de cette machine" $choices -}}

encryption = "age"

# /tmp est monté noexec sur certaines machines (NAS Synology), ce qui empêche
# chezmoi d'exécuter les scripts run_*. Le répertoire doit exister.
scriptTempDir = "{{ .chezmoi.homeDir }}/.cache/chezmoi"

[age]
    passphrase = true

[data]
    profile = {{ $profile | quote }}
