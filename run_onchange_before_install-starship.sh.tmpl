#!/bin/sh
# Installe starship si absent. Rejoué quand STARSHIP_VERSION change.
# STARSHIP_VERSION: 1.23.0

set -eu

if command -v starship >/dev/null; then
  exit 0
fi

{{ if eq .chezmoi.os "darwin" -}}
if command -v brew >/dev/null; then
  brew install starship
  exit 0
fi
{{ end -}}

# Pas de gestionnaire de paquets utilisable (NAS Synology, conteneur…) :
# binaire statique dans ~/bin, ajouté au PATH par .zprofile.
mkdir -p "$HOME/bin"
if curl -fsSL https://starship.rs/install.sh | sh -s -- -b "$HOME/bin" -y; then
  echo "🚀  starship installé dans ~/bin"
else
  echo "⚠️   starship non installé, le prompt zsh par défaut sera utilisé" >&2
fi
